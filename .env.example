# Frontend (Vite) — set in .env.local for dev, and in Vercel project settings
# for production. These values are public (the anon key is safe to expose;
# RLS protects the data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge Function secrets — NOT used by the frontend. Set them with:
#   npx supabase secrets set RESEND_API_KEY=... EMAIL_FROM=... APP_URL=... CRON_SECRET=...
# RESEND_API_KEY  Resend API key (https://resend.com)
# EMAIL_FROM      verified sender address, e.g. roster@yourchurch.org
# APP_URL         public URL of the deployed app, e.g. https://roster.yourchurch.org
#                 (no trailing slash — emails build their links from it)
# CRON_SECRET     long random string; the hourly reminder job proves itself with it

# Supabase Vault — read by the pg_cron job that calls the `reminders` function.
# Create them once per instance (see docs/SETUP.md step 7):
#   npx supabase db query --linked "select vault.create_secret('<value>', '<name>')"
# reminders_function_url   https://<project-ref>.supabase.co/functions/v1/reminders
# reminders_cron_secret    the same value as CRON_SECRET above

# Local Edge Function development uses .env.functions.local (gitignored) with
# APP_URL=http://localhost:5173 and a throwaway CRON_SECRET:
#   npx supabase functions serve --env-file .env.functions.local
